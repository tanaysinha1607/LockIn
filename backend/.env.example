# ───────────────────────────────────────────────────────────────
# LockIn Backend — Environment Configuration
# Copy this file to .env and fill in the values.
# ───────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000                          # Port the Express + Socket.io server listens on
NODE_ENV=development               # development | staging | production

# ── MongoDB (REQUIRED) ───────────────────────────────────────
# The server exits with code 1 if it cannot connect.
# Local:   mongodb://127.0.0.1:27017/lockin
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lockin?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lockin

# ── Redis (REQUIRED in config, but server runs without it) ───
# Joi validation requires this value to exist, but if Redis is
# unreachable the server continues with warning logs.
# Used for rate limiting (falls back to in-memory counters without it).
# Local:   redis://127.0.0.1:6379
# Cloud:   redis://<user>:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# ── JWT Authentication (REQUIRED) ────────────────────────────
# Minimum 8 characters each. Use strong random strings in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your_super_secret_access_key_change_me_in_production
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_change_me_in_production

# Token lifetimes (ms/s/m/h/d format — parsed by jsonwebtoken)
ACCESS_TOKEN_EXPIRE=15m            # Access token TTL (default: 15 minutes)
REFRESH_TOKEN_EXPIRE=7d            # Refresh token TTL (default: 7 days)

# ── AI Coach (OPTIONAL) ──────────────────────────────────────
# If no key is set, AI features use template fallback responses.
# Workout plans, diet plans, and coach chat all still work without this.
# Groq (free tier) — get a key at https://console.groq.com/keys. Used first when set.
GROQ_API_KEY=
GROQ_MODEL=                        # Optional. Empty = llama-3.3-70b-versatile
# xAI Grok — https://console.x.ai. Used when GROQ_API_KEY is empty.
XAI_API_KEY=
XAI_MODEL=                         # Optional: pin a model (e.g. grok-3-mini). Empty = auto-pick a fast one
# Alternative provider, only used when XAI_API_KEY is empty:
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ORG_ID=

# ── AI Feature Flags ─────────────────────────────────────────
AI_ENABLED=true                    # Set to false to force all AI to use fallback templates
AI_DAILY_BUDGET_CENTS=500          # Informational budget cap (not enforced in code)

# Rate limits (optional). Defaults: strict in production, loose in development.
# RATE_LIMIT_LOGIN=10        # login attempts per IP per 15 min
# RATE_LIMIT_REGISTER=5      # new accounts per IP per hour
# RATE_LIMIT_TOKEN=60        # refresh/logout calls per IP per 15 min
# RATE_LIMIT_AI=30           # AI coach calls per user per hour

# GPS check-in (optional)
# CHECKIN_RADIUS_METERS=300        # how close to the saved gym a check-in must be
# CHECKIN_REQUIRE_GPS=true          # default: true in production, false otherwise
# GYM_LOCATION_COOLDOWN_DAYS=7      # how often a user may move their gym

# Push notifications (optional)
# PUSH_ENABLED=false               # turn off phone push (in-app notifications still work)
# EXPO_ACCESS_TOKEN=               # only if you enable "enhanced push security" in your Expo account
# REMINDERS_ENABLED=false          # turn off daily check-in / streak reminder pushes

# ── Deployment (Render) ──────────────────────────────────────
# CORS_ORIGINS=https://your-app.vercel.app   # comma-separated; empty = allow all (dev only)
# TRUST_PROXY=1                              # defaults to 1 when NODE_ENV=production
# REDIS_URL may be left empty in production; rate limits then use memory.
