{
  "name": "lockin-backend",
  "version": "1.0.0",
  "description": "Backend API for LockIn - AI Gym Accountability Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/jobs/seed.js",
    "seed:badges": "node scripts/seed-badges.js",
    "seed:challenges": "node scripts/seed-challenges.js",
    "verify": "node scripts/verify-mvp.js",
    "verify:phase4": "node scripts/verify-phase4-syntax.js && node scripts/verify-phase4-chat.js",
    "verify:phase4:syntax": "node scripts/verify-phase4-syntax.js",
    "verify:phase5": "node scripts/verify-phase5.js",
    "verify:phase6": "node scripts/verify-phase6.js",
    "ai:check": "node scripts/check-ai.js",
    "verify:all": "npm run verify && npm run verify:phase4 && npm run verify:phase5 && npm run verify:phase6 && npm run verify:phase7",
    "verify:phase7": "node scripts/verify-phase7.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "openai": "^6.44.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
