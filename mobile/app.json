{
  "expo": {
    "name": "LockIn",
    "slug": "lockin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "LockIn"
    },
    "extra": {
      "apiUrl": "http://127.0.0.1:5000/api/v1",
      "eas": {
        "projectId": "28f0bc3e-1f73-4694-b776-93c88d6d1f74"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LockIn uses your location to save your gym and confirm you're there when you check in."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      "expo-status-bar"
    ],
    "owner": "tanay1607s-team"
  }
}
